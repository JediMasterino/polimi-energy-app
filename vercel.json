{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://vitals.vercel-insights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://climate.onebuilding.org https://energyplus-weather.s3.amazonaws.com https://re.jrc.ec.europa.eu https://tile.openstreetmap.org https://server.arcgisonline.com https://basemaps.cartocdn.com https://va.vercel-scripts.com https://vitals.vercel-insights.com blob:; worker-src 'self' blob:; frame-ancestors 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/onebuilding/:path*",
      "destination": "https://climate.onebuilding.org/:path*"
    },
    {
      "source": "/epw-s3/:path*",
      "destination": "https://energyplus-weather.s3.amazonaws.com/:path*"
    },
    {
      "source": "/pvgis-api/:path*",
      "destination": "https://re.jrc.ec.europa.eu/api/v5_2/:path*"
    },
    {
      "source": "/map-osm/:path*",
      "destination": "https://tile.openstreetmap.org/:path*"
    },
    {
      "source": "/map-esri/:path*",
      "destination": "https://server.arcgisonline.com/ArcGIS/rest/services/:path*"
    }
  ]
}